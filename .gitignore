# ============================================================================
# Alyssa AI — .gitignore
# ============================================================================

# --- Environment ---
.env
venv/
.venv/
__pycache__/
*.pyc
*.pyo
tokens/
api_keys/
logs/

# --- Large data / datasets (generated or downloaded) ---
data/
datasets/
*.jsonl

# --- Model files ---
models/
*.gguf
*.safetensors
*.bin
*.pth
*.pkl

# --- Build output ---
build/
*.exe
*.dll
*.lib
*.exp
*.ilk
*.obj
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tlh
*.tmp
*.log
*.user
*.suo
*.sdf
*.VC.db
*.VC.VC.opendb
*.aps
*.ncb
*.opendb

# --- Language-server / IDE / Editor config ---
.obsidian/
docs/.obsidian/
.vscode/
.idea/
*.code-workspace
*.sln.iml
*.swp

# --- Submodule / vendor build dirs ---
llama.cpp/
whisper.cpp/
spdlog/
piper/
opencv/
opencv_contrib/
paho.mqtt.cpp

# --- CA certificate (re-download at build time) ---
config/cacert-*.pem

# --- Documentation build artifacts ---
docs/html/
docs/latex/
docs/xml/

# --- pi agent artifacts ---
.pi/
.agents
skills-lock.json

# --- vcpkg build artifacts ---
vcpkg/buildtrees/
vcpkg/downloads/
vcpkg/installed/
vcpkg/packages/
vcpkg_installed/

# --- macOS ---
.DS_Store

# --- Database / memory files ---
*.db
*.sqlite

# --- Overlay / miscellaneous ---
overlay/
nul