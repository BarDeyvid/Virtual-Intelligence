{
  "fusion_config": {
    "strategy": "neural",
    "enable_embedding_cache": true,
    "enable_emotion_modulation": true,
    "debug_mode": false
  },
  "emotions": {
    "happy": {
      "keywords": ["feliz", "alegre", "amo", "adorei", "legal", "bom", "ótimo", "lindo", "maravilhoso", "excelente"],
      "boosted_experts": ["creativeModel", "museModel", "emotionalModel"],
      "weight_multiplier": 1.3,
      "semantic_similarity_threshold": 0.65
    },
    "sad": {
      "keywords": ["triste", "infeliz", "deprimido", "choro", "sofro", "mal", "ruim", "pior", "horrível"],
      "boosted_experts": ["emotionalModel", "peacekeeperModel", "zenModel"],
      "weight_multiplier": 1.2,
      "semantic_similarity_threshold": 0.65
    },
    "angry": {
      "keywords": ["raiva", "furioso", "odeio", "péssimo", "inferno", "decepção", "frustrado", "indignado"],
      "boosted_experts": ["cynicalModel", "analyticalModel", "strategicModel"],
      "weight_multiplier": 1.15,
      "semantic_similarity_threshold": 0.6
    },
    "anxious": {
      "keywords": ["ansioso", "nervoso", "medo", "preocupado", "assustado", "pânico", "incerto"],
      "boosted_experts": ["zenModel", "introspectiveModel", "peacekeeperModel"],
      "weight_multiplier": 1.2,
      "semantic_similarity_threshold": 0.62
    },
    "analytical": {
      "keywords": ["porque", "como funciona", "pensar", "analisar", "explique", "entenda", "lógica", "racional"],
      "boosted_experts": ["analyticalModel", "introspectiveModel", "memoryModel"],
      "weight_multiplier": 1.25,
      "semantic_similarity_threshold": 0.7
    },
    "social": {
      "keywords": ["oi", "olá", "bom dia", "boa noite", "tchau", "como vai", "tudo bem", "conversando"],
      "boosted_experts": ["socialModel", "peacekeeperModel", "emotionalModel"],
      "weight_multiplier": 1.15,
      "semantic_similarity_threshold": 0.6
    },
    "creative": {
      "keywords": ["ideia", "criatividade", "imagine", "história", "ficção", "possível", "diferente", "único"],
      "boosted_experts": ["creativeModel", "museModel"],
      "weight_multiplier": 1.2,
      "semantic_similarity_threshold": 0.65
    }
  },
  "expert_keyword_mapping": {
    "socialModel": {
      "keywords": ["oi", "olá", "bom", "tchau", "conversando", "social"],
      "base_weight": 0.12
    },
    "introspectiveModel": {
      "keywords": ["porque", "como", "pensar", "analisar", "motivação"],
      "base_weight": 0.15
    },
    "emotionalModel": {
      "keywords": ["feliz", "triste", "sinto", "emoção", "sentimento"],
      "base_weight": 0.15
    },
    "creativeModel": {
      "keywords": ["ideia", "imagine", "criatividade", "história"],
      "base_weight": 0.12
    },
    "analyticalModel": {
      "keywords": ["lógica", "explique", "análise", "dados", "racional"],
      "base_weight": 0.15
    },
    "memoryModel": {
      "keywords": ["lembr", "memória", "passado", "antes", "histórico"],
      "base_weight": 0.12
    },
    "strategicModel": {
      "keywords": ["plano", "objetivo", "estratégia", "resultado", "caminho"],
      "base_weight": 0.12
    },
    "cynicalModel": {
      "keywords": ["verdade", "realidade", "honesto", "crítica"],
      "base_weight": 0.10
    },
    "peacekeeperModel": {
      "keywords": ["harmonia", "acordo", "solução", "juntos"],
      "base_weight": 0.10
    },
    "zenModel": {
      "keywords": ["calma", "equilíbrio", "serenidade", "paz"],
      "base_weight": 0.10
    },
    "museModel": {
      "keywords": ["possibilidade", "oportunidade", "potencial", "esperança"],
      "base_weight": 0.11
    }
  },
  "weight_parameters": {
    "emotion_weight_base": 0.3,
    "context_similarity_weight": 0.4,
    "historical_relevance_weight": 0.3,
    "softmax_temperature": 1.0,
    "min_weight_threshold": 0.05,
    "affinity_decay_factor": 0.95
  },
  "optimization": {
    "embedding_cache_size": 1024,
    "cache_ttl_seconds": 300,
    "batch_similarity_computation": true,
    "use_quantized_embeddings": false
  }
